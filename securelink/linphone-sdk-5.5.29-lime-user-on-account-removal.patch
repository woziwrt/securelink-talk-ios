+// SecureLink (2. 11. 2026): an account removed with its data takes its local LIME identity along. Otherwise the same
+// phone signed in again (block then unblock, or wipe then a new invitation) keeps the old identity while the server no
+// longer knows it (blocking deletes the keys): only the daily update republishes it, so the person stays unreachable
+// for up to 24 h. LimeManager::delete_user removes the local user first, then asks the server (already gone: fine).
+// The device id is built as Account::update() builds it when the account has no contact address (not registered).
+void LimeX3dhEncryptionEngine::deleteLimeUser(const std::shared_ptr<Account> &account) {
+	if (!limeManager || !account) return;
+	std::string localDeviceId;
+	const auto &contact = account->getContactAddress();
+	if (contact && contact->hasUriParam("gr")) {
+		localDeviceId = contact->asStringUriOnly();
+	} else {
+		const auto &identity = account->getAccountParams()->getIdentityAddress();
+		const auto gr = getCore()->getCCore()->sal->getUuid();
+		if (!identity || gr.empty()) return;
+		auto addr = identity->clone()->toSharedPtr();
+		addr->setUriParam("gr", "urn:uuid:" + gr);
+		localDeviceId = addr->asStringUriOnly();
+	}
+	for (const auto curve : {lime::CurveId::c25519, lime::CurveId::c448, lime::CurveId::c25519k512,
+	                         lime::CurveId::c25519mlk512, lime::CurveId::c448mlk1024}) {
+		try {
+			const lime::DeviceId deviceId(localDeviceId, curve);
+			if (!limeManager->is_user(deviceId)) continue;
+			lInfo() << "[LIME] removing the local LIME user " << localDeviceId << " ["
+			        << lime::CurveId2String(curve) << "] with its account";
+			limeManager->delete_user(deviceId, [localDeviceId](lime::CallbackReturn returnCode, std::string info) {
+				lInfo() << "[LIME] server deletion of " << localDeviceId << ": "
+				        << (returnCode == lime::CallbackReturn::success ? "done" : "not needed or failed (" + info + ")");
+			});
+		} catch (const std::exception &e) {
+			lWarning() << "[LIME] cannot remove the local LIME user " << localDeviceId << ": " << e.what();
+		}
+	}
+	usersAlgos.erase(localDeviceId);
+}
